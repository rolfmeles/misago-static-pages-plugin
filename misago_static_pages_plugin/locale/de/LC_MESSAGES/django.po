msgid "Static Pages"
msgstr "Statische Seiten"

#: misago_static_pages_plugin/misago_plugin.py:11
msgctxt "mspp"
msgid "Allows to create static pages in the admin panel, e.g. for information and ressources that don't need to be a forum thread."
msgstr "Ermöglicht das Erstellen statischer Seiten im Admin-Bereich, z. B. für Informationen und Ressourcen, die nicht als Forenthread veröffentlicht werden sollen."

